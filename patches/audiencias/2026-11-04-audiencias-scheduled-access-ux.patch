+def test_rooms_api_exposes_scheduled_access(client):
+    room = baker.make(
+        Room,
+        broadcast_type=Room.BROADCAST_LIVE,
+        youtube_status=0,
+        release_at=timezone.now() + timedelta(hours=1),
+    )
+
+    data = RoomSerializer(room).data
+
