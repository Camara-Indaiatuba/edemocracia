diff --git a/apps/core/tests/test_admin.py b/apps/core/tests/test_admin.py
new file mode 100644
--- /dev/null
+++ b/apps/core/tests/test_admin.py
@@ -0,0 +1,32 @@
+from django.utils.translation import gettext
+
+from apps.core.admin import ROOM_REQUIRED_FIELDS, RoomAdminForm
+
+
+def test_room_admin_marks_essential_fields_as_required():
+    form = RoomAdminForm()
+
+    for field_name in ROOM_REQUIRED_FIELDS:
+        assert form.fields[field_name].required is True
+
+
+def test_room_admin_shows_required_errors_instead_of_saving():
+    form = RoomAdminForm(data={})
+
+    assert form.is_valid() is False
+    required_message = gettext('This field is required.')
+    for field_name in ROOM_REQUIRED_FIELDS:
+        assert list(form.errors[field_name]) == [required_message]
+
+
+def test_room_admin_keeps_advance_fields_optional():
+    form = RoomAdminForm()
+
+    optional_fields = (
+        'cod_reunion',
+        'reunion_theme',
+        'location',
+        'external_link',
+    )
+    for field_name in optional_fields:
+        assert form.fields[field_name].required is False
