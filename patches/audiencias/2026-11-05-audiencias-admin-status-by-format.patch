diff --git a/static/js/room-admin-status.js b/static/js/room-admin-status.js
new file mode 100644
--- /dev/null
+++ b/static/js/room-admin-status.js
@@ -0,0 +1,38 @@
+(function () {
+  'use strict';
+
+  function updateStatusOptions() {
+    var broadcastType = document.getElementById('id_broadcast_type');
+    var status = document.getElementById('id_youtube_status');
+    if (!broadcastType || !status) return;
+
+    var isLive = broadcastType.value === 'live';
+    var liveOption = status.querySelector('option[value="1"]');
+    var closedOption = status.querySelector('option[value="2"]');
+
+    if (liveOption) {
+      liveOption.hidden = !isLive;
+      liveOption.disabled = !isLive;
+    }
+    if (closedOption) {
+      closedOption.textContent = isLive ? 'Transmissão encerrada' : 'Publicada';
+    }
+
+    if (!isLive && status.value === '1') {
+      status.value = '0';
+    }
+  }
+
+  function initialize() {
+    var broadcastType = document.getElementById('id_broadcast_type');
+    if (!broadcastType) return;
+    broadcastType.addEventListener('change', updateStatusOptions);
+    updateStatusOptions();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initialize);
+  } else {
+    initialize();
+  }
+}());
