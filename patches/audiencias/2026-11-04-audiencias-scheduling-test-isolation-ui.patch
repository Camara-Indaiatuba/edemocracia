--- /dev/null
+++ b/conftest.py
@@ -0,0 +1,19 @@
+import pytest
+from channels.layers import InMemoryChannelLayer
+
+
+@pytest.fixture(autouse=True)
+def isolate_channel_layers(settings, monkeypatch):
+    """Keep test events away from the Redis used by the running site."""
+    settings.CHANNEL_LAYERS = {
+        'default': {
+            'BACKEND': 'channels.layers.InMemoryChannelLayer',
+        },
+    }
+    channel_layer = InMemoryChannelLayer()
+
+    from apps.core import models, views
+
+    monkeypatch.setattr(models, 'channel_layer', channel_layer)
+    monkeypatch.setattr(views, 'channel_layer', channel_layer)
+    return channel_layer
