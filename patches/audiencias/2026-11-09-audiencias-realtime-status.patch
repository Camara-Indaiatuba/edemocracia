+@pytest.mark.django_db
+def test_home_notification_contains_room_classification():
+    room = baker.make(
+        Room,
+        youtube_status=0,
+        is_visible=True,
+    )
+    baker.make(Video, room=room, is_attachment=False)
+
+    payload = room.home_notification_payload()
+
+    assert payload['id'] == room.id
+    assert payload['youtube_status'] == 0
+    assert payload['is_visible'] is True
+    assert payload['is_closed'] is False
+    assert 'data-video-id="%s"' % room.id in payload['html']
+
