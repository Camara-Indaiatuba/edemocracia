diff --git a/apps/core/management/commands/release_scheduled_rooms.py b/apps/core/management/commands/release_scheduled_rooms.py
new file mode 100644
index 0000000..714c83f
--- /dev/null
+++ b/apps/core/management/commands/release_scheduled_rooms.py
@@ -0,0 +1,33 @@
+from django.core.management.base import BaseCommand
+from django.utils import timezone
+
+from apps.core.models import Room
+
+
+class Command(BaseCommand):
+    help = 'Publica vídeos gravados cuja liberação agendada já venceu.'
+
+    def handle(self, *args, **options):
+        now = timezone.now()
+        rooms = list(Room.objects.filter(
+            youtube_status=0,
+            broadcast_type=Room.BROADCAST_RECORDED,
+            release_at__lte=now,
+            is_active=True,
+            is_visible=True,
+        ))
+
+        if rooms:
+            room_ids = [room.id for room in rooms]
+            Room.objects.filter(id__in=room_ids).update(
+                youtube_status=2,
+                closed_time=now,
+                modified=now,
+            )
+            for room in rooms:
+                room.youtube_status = 2
+                room.closed_time = now
+                room.send_notification(is_closed=True)
+
+        self.stdout.write(
+            self.style.SUCCESS('%d sala(s) gravada(s) publicada(s).' % len(rooms)))
