diff --git a/apps/core/tests/test_commands.py b/apps/core/tests/test_commands.py
new file mode 100644
index 0000000..f6c4ce1
--- /dev/null
+++ b/apps/core/tests/test_commands.py
@@ -0,0 +1,51 @@
+from datetime import timedelta
+from unittest.mock import patch
+
+import pytest
+from django.core.management import call_command
+from django.utils import timezone
+from model_bakery import baker
+
+from apps.core.models import Room
+
+
+@pytest.mark.django_db
+@patch('apps.core.models.Room.send_notification')
+def test_release_scheduled_recording(send_notification):
+    room = baker.make(
+        Room,
+        youtube_status=0,
+        broadcast_type=Room.BROADCAST_RECORDED,
+        release_at=timezone.now() - timedelta(minutes=1),
+        is_active=True,
+        is_visible=True,
+    )
+    send_notification.reset_mock()
+
+    call_command('release_scheduled_rooms')
+    room.refresh_from_db()
+
+    assert room.youtube_status == 2
+    assert room.closed_time is not None
+    send_notification.assert_called_once_with(is_closed=True)
+
+
+@pytest.mark.django_db
+@patch('apps.core.models.Room.send_notification')
+def test_release_command_keeps_live_room_waiting(send_notification):
+    room = baker.make(
+        Room,
+        youtube_status=0,
+        broadcast_type=Room.BROADCAST_LIVE,
+        release_at=timezone.now() - timedelta(minutes=1),
+        is_active=True,
+        is_visible=True,
+    )
+    send_notification.reset_mock()
+
+    call_command('release_scheduled_rooms')
+    room.refresh_from_db()
+
+    assert room.youtube_status == 0
+    assert room.display_status == 'Aguardando o início da transmissão'
+    send_notification.assert_not_called()
